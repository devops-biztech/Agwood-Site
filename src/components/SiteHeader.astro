---
import { COMPANY } from '../data/company.ts';
import { PAGES, navLabel } from '../data/site.ts';
import Emblem from './Emblem.astro';

const here = Astro.url.pathname;
---
<!--
  The header sits on the dark field on every page and runs continuous with the
  hero beneath it, so the top of the site is one uninterrupted band of the logo’s
  own green rather than a strip balanced on top of a different colour. There is no
  border under it; the colour change where the field ends is the division.
-->
<header class="hdr">
  <div class="shell hdr-in">
    <a class="brand" href="/">
      <!-- The emblem only. The wordmark baked into the raster is never used: the
           company name is live type so it is selectable, crisp at every density,
           and not pushed through a lossy scan.

           Vector since 2026-08-27. It takes its colour from the header's own
           `color`, so there is no second white asset to keep in step with the
           palette, and no request — the mark is part of the document. -->
      <Emblem height={64} class="mark" />
      <span class="wm">{COMPANY.name}</span>
    </a>
    <!--
      The disclosure button. A `<button>` and not a link: it operates a control on
      this page rather than going anywhere, and `aria-expanded` is the whole
      contract — it is what tells a screen reader the state the three links are in.

      It is rendered on every page and at every width, and CSS decides when it is
      seen: never without JavaScript, and never above 560px. Rendering it
      conditionally would mean rendering it from a viewport guess on the server.
    -->
    <button id="menu" class="burger" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="bars" aria-hidden="true"></span>
      
    </button>
    <nav id="primary-nav" aria-label="Primary">
      {PAGES.map((p) => (
        <a href={p.path} class:list={['nav', { 'is-current': here === p.path }]}
           aria-current={here === p.path ? 'page' : undefined}>{navLabel(p)}</a>
      ))}
    </nav>
  </div>
</header>

<!--
  The disclosure pattern, whole: toggle, Escape, click-away, and a close when the
  viewport grows past the breakpoint so an open panel can never strand itself as a
  column inside a row. No focus trap and no scroll lock — this is a disclosure, not
  a modal. WAI-ARIA asks for a trap on a dialog that covers the page; trapping the
  keyboard inside three links that sit in the document flow would be an invention,
  and one that keyboard users would have to escape from.

  `is:inline` so it stays in the document rather than becoming a second request.
  It is a dozen lines; a network round trip to carry them would cost more than they
  weigh, on rural signal most of all.
-->
<script is:inline>
  (function () {
    var btn = document.getElementById('menu');
    var nav = document.getElementById('primary-nav');
    if (!btn || !nav) return;
    var hdr = btn.closest('.hdr');

    function set(open) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      nav.classList.toggle('is-open', open);
    }
    function isOpen() {
      return btn.getAttribute('aria-expanded') === 'true';
    }

    btn.addEventListener('click', function () { set(!isOpen()); });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || !isOpen()) return;
      set(false);
      // Focus goes back to the control that opened the panel. Leaving it on a link
      // that has just been hidden drops the keyboard user at the top of the document.
      btn.focus();
    });

    // Anywhere outside the header closes it. Clicks on the links inside are left
    // alone — they are navigating, and the next page renders the menu closed.
    document.addEventListener('click', function (e) {
      if (isOpen() && !hdr.contains(e.target)) set(false);
    });

    var wide = window.matchMedia('(min-width: 560px)');
    var onChange = function () { if (wide.matches) set(false); };
    if (wide.addEventListener) wide.addEventListener('change', onChange);
    else wide.addListener(onChange);
  })();
</script>

<style>
  /* Sticky at every width, which is what the disclosure buys. The telephone is the
     only way into this business and the nav is the only route to it, so a header
     that scrolls away means that for most of the page the one thing a buyer needs
     is somewhere they have already passed.

     This used to be sticky only above 560px: the brand and three links wrapped to
     two rows on a phone, and a ~160px bar eats a fifth of the viewport on exactly
     the device most of these visitors use. One row plus a button is ~100px, which
     is a share of the screen worth paying. z-index stays under the skip link's 10
     so the keyboard route is never covered. Nothing shrinks on scroll: the emblem
     has a measured 64px legibility floor and a header that collapses would drive it
     straight through that floor. */
  .hdr {
    background: var(--forest-deep);
    color: var(--on-deep);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .hdr-in { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding-block: 1.1rem; }
  .brand { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; color: var(--on-deep); }
  /* 64px is a measured floor, not a preference. The emblem was rendered at 44, 56,
     64, 72 and 88; below 64 the conifer branches merge into a blob and the
     monogram stops reading. Do not shrink this to tighten the header. */
  .brand :global(.mark) { height: 64px; width: auto; display: block; }
  .wm {
    font-family: var(--font-display);
    font-variation-settings: var(--axis-title);
    font-weight: 600;
    font-size: var(--size-title);
    line-height: 1.05;
    letter-spacing: -0.005em;
    max-width: 9ch;
  }

  /* ── The nav, with no script ────────────────────────────────────────────────
     The base state is the one that needs no JavaScript: three links, always
     visible, wrapping to their own row on a narrow phone. `margin-left: auto`
     would strand that row right-aligned under a left-aligned brand, so below 480px
     it is dropped and the row starts at the same gutter as everything else.
     Everything below this block is layered on top of a nav that already works. */
  nav { margin-left: auto; display: flex; gap: clamp(1rem, 3vw, 1.6rem); }
  @media (max-width: 480px) {
    nav { margin-left: 0; width: 100%; }
  }
  .nav {
    font-size: var(--size-fine);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-deep-dim);
    text-decoration: none;
    /* Padding is what takes this past a 44px tap target, not the font size. The
       primary visitor is on a phone, frequently outdoors. */
    padding: 0.75rem 0.15rem;
  }
  /* The state colour marks where you are, and never marks anything else. On the
     dark field it takes its reversed variant so it stays legible. */
  .nav.is-current { color: var(--on-deep-mark); }
  .nav:hover { color: var(--on-deep); }
  .nav.is-current:hover { color: var(--on-deep-mark); }
  :where(.brand, .nav, .burger):focus-visible { outline: 3px solid var(--on-deep); outline-offset: 3px; }

  /* ── The disclosure ─────────────────────────────────────────────────────────
     Gated on `html.js`, which Base.astro sets before first paint. With scripting
     off the button never appears and the nav above is never hidden — the version
     of this that hides the nav by default and reveals it with script is the version
     that ships a site with no navigation to anyone whose script fails. */
  .burger {
    /* Hidden by default rather than shown: the default has to be the no-script
       state, or the failure mode is a button that does nothing. */
    display: none;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
    background: none;
    border: 0;
    color: var(--on-deep);
    font-family: inherit;
    font-size: var(--size-fine);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* Matches .nav, and for the same reason: padding is what clears 44px. The
       line-height is set rather than left to the button default of `normal`, which
       is ~1.2 and lands the box at 38px — under the touch floor, and a different
       height from the links it sits beside. */
    line-height: 1.65;
    padding: 0.75rem 0.15rem;
    cursor: pointer;
  }
  /* Three flat bars, drawn rather than fetched, that fold into a cross when the
     panel is open. Square ends and no radius: nothing on this site has a rounded
     corner, an icon set least of all. */
  .bars, .bars::before, .bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    transition: transform 0.22s var(--ease), top 0.22s var(--ease), background-color 0.22s var(--ease);
  }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -6px; }
  .bars::after { top: 6px; }
  .burger[aria-expanded='true'] .bars { background: transparent; }
  .burger[aria-expanded='true'] .bars::before { top: 0; transform: rotate(45deg); }
  .burger[aria-expanded='true'] .bars::after { top: 0; transform: rotate(-45deg); }

  :global(html.js) .burger { display: inline-flex; }
  :global(html.js) nav { display: none; }
  :global(html.js) nav.is-open { display: flex; }

  /* The open panel is a full-width row inside the bar, not an overlay: the header
     is already the sticky element, so the panel can simply be the second row of it
     and nothing has to be positioned, layered or locked. */
  @media (max-width: 559.98px) {
    :global(html.js) nav.is-open {
      flex-direction: column;
      gap: 0;
      width: 100%;
      margin-left: 0;
      margin-top: 0.5rem;
      border-top: 1px solid var(--rule-on-deep);
    }
    /* A hairline BETWEEN rows, never around them — the same rule the cell row
       follows. Full-width rows so the tap target is the row, not the word. */
    :global(html.js) nav.is-open .nav { padding: 0.95rem 0; }
    :global(html.js) nav.is-open .nav + .nav { border-top: 1px solid var(--rule-on-deep); }
  }
  /* Above the breakpoint the three links are the nav again and the button is gone,
     whatever state the panel was left in. */
  @media (min-width: 560px) {
    :global(html.js) .burger { display: none; }
    :global(html.js) nav { display: flex; }
  }
</style>
