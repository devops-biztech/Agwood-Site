---
import { COMPANY } from '../data/company.ts';
import { PAGES } from '../data/site.ts';

// Trailing slashes are enforced by astro.config, so a plain equality test is
// enough here and matches the sitemap's URLs exactly.
const here = Astro.url.pathname;
---
<header class="hdr">
  <div class="shell hdr-in">
    <a class="brand" href="/">
      <!-- The emblem only. The wordmark baked into the raster is never used: the
           company name is set in live type beside it so it is selectable, crisp at
           every pixel density, and not pushed through a lossy scan. -->
      <img src="/assets/emblem-forest.png" width="75" height="64" alt=""
           decoding="async" />
      <span class="wm">{COMPANY.name}</span>
    </a>
    <nav aria-label="Primary">
      {PAGES.map((p) => (
        <a href={p.path} class:list={['nav', { 'is-current': here === p.path }]}
           aria-current={here === p.path ? 'page' : undefined}>
          {p.path === '/' ? 'Home' : p.title.replace('About the Mill', 'About')}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .hdr { background: var(--paper); }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--ink);
  }
  /* 64px is a measured floor, not a preference. The emblem was rendered at 44,
     56, 64, 72 and 88; below 64 the conifer branches merge into a blob and the
     monogram stops reading. Do not shrink this to tighten the header. */
  .brand img { height: 64px; width: auto; }
  .wm {
    font-family: var(--font-display);
    font-variation-settings: var(--axis-title);
    font-weight: 600;
    font-size: var(--size-title);
    line-height: 1.05;
    letter-spacing: -0.005em;
    max-width: 9ch;
  }
  nav { margin-left: auto; display: flex; gap: clamp(1rem, 3vw, 1.6rem); }
  .nav {
    font-size: 0.78rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-decoration: none;
    /* Large tap target: the primary visitor is on a phone, often outdoors. The
       padding is what makes this reach 44px, not the font size. */
    padding: 0.75rem 0.15rem;
  }
  /* Russet marks where you are and nothing else. It is never a link colour, and
     green never marks position — being somewhere is not doing something. */
  .nav.is-current { color: var(--russet); }
  .nav:hover { color: var(--ink); }
  .nav.is-current:hover { color: var(--russet); }
</style>
