---
import { cathedralSvg } from '../lib/grain.ts';

// The cathedral figure of a flatsawn redwood board: nested arches at the centre
// relaxing continuously into vertical grain at the edges, which is what a real
// flatsawn board does. It falls out of the geometry rather than being composed.
//
// Appears exactly ONCE across the whole site, on the home page. A second one
// would make it a texture instead of an event.
const svg = cathedralSvg({
  width: 1400, height: 480, rings: 32, seed: 21,
  gapf: 0.07, latefrac: 0.3, tight: 0.38, stretch: 2.15,
});
---
<div class="vault" set:html={svg} />

<style>
  .vault { height: var(--vault-height); overflow: hidden; }
  .vault :global(svg) { display: block; width: 100%; height: 100%; }

  /* The vault surfaces from the bottom up, the way grain appears as a board is
     planed — so the crown of the arch completes last. It runs once and never
     repeats; a looping hero animation would turn the site's one gesture into
     wallpaper. Gated behind :root.js so a visitor without scripting sees the
     finished vault rather than a clipped one. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) .vault :global(svg) {
      clip-path: inset(100% 0 0 0);
      animation: surface 1.7s var(--ease) 0.15s forwards;
    }
  }
  @keyframes surface { to { clip-path: inset(0 0 0 0); } }
</style>
