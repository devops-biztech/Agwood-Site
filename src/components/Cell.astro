---
interface Props {
  /** The category this cell answers. Small, in the state colour. */
  label: string;
  heading: string;
  /** The fact the argument resolves to. */
  value: string;
  /** True when the value is a gap being named rather than data being held. */
  unknown?: boolean;
  href?: string;
}
const { label, heading, value, unknown = false, href } = Astro.props;
---
<article class="cell">
  <p class="label lb">{label}</p>
  <h2>{heading}</h2>
  <p class="prose"><slot /></p>
  <p class:list={['val', { unknown }]}>
    {href ? <a href={href}>{value}</a> : value}
  </p>
</article>

<style>
  .cell {
    padding: clamp(1.75rem, 4vw, 2.4rem) clamp(1.25rem, 3vw, 1.9rem);
    display: flex;
    flex-direction: column;
  }
  /* Cancel the field’s own inline padding on the outer cells so the row spans the
     shell edge to edge; otherwise the first and last cells sit inset from
     everything else on the page. */
  .cell:first-child { padding-left: 0; }
  .cell:last-child { padding-right: 0; }
  .lb { color: var(--russet); margin-bottom: 1rem; }
  /* The subhead step: a heading in a narrow column cannot carry the full headline
     size without wrapping to four lines, and this argument sits above the fact
     rather than being the fact. */
  h2 {
    font-size: var(--size-subhead);
    line-height: 1.08;
    margin-bottom: 0.75rem;
  }
  .prose { font-size: var(--size-body); max-width: none; }
  /* The value sits at the bottom of every cell regardless of how long the argument
     above it runs, so the three facts line up across the row.

     It is also the PAYLOAD of this device — the checkable fact the argument
     resolves to — and it used to be set smaller than the argument above it, which
     inverted the row's own hierarchy and is why three facts meant to read as a set
     read as footnotes. It now outweighs the heading. Same precedent as the contact
     page's phone number outweighing its h1: heading level is document structure,
     size is emphasis, and the fact is what carries the emphasis here. */
  .val {
    margin-top: auto;
    padding-top: 1.2rem;
    font-family: var(--font-display);
    font-variation-settings: var(--axis-headline);
    font-size: var(--size-headline);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--ink);
    text-wrap: balance;
  }
  /* A named gap is demoted to body type in the state colour so it can never be
     mistaken for a fact we hold. */
  .val.unknown {
    font-family: var(--font-body);
    font-variation-settings: 'wdth' 100;
    font-size: var(--size-control);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--russet);
  }
  /* Vertical padding on an inline link expands the hit area without moving anything
     around it — the line box is unchanged. Takes this from ~17px to over the 24px
     WCAG 2.2 minimum; it is the last element in the cell, so nothing sits under it. */
  .val a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding-block: 0.45rem;
  }
  @media (max-width: 760px) {
    .cell { padding-left: 0; padding-right: 0; }
    .val { margin-top: 1rem; }
  }
</style>
