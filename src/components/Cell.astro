---
interface Props {
  /** The category this cell answers. Small, in the state colour. */
  label: string;
  heading: string;
  /** The fact the argument resolves to. */
  value: string;
  /** True when the value is a gap being named rather than data being held. */
  unknown?: boolean;
  href?: string;
}
const { label, heading, value, unknown = false, href } = Astro.props;
---
<article class="cell">
  <p class="label lb">{label}</p>
  <h2>{heading}</h2>
  <p class="prose"><slot /></p>
  <p class:list={['val', { unknown }]}>
    {href ? <a href={href}>{value}</a> : value}
  </p>
</article>

<style>
  .cell {
    padding: clamp(1.75rem, 4vw, 2.4rem) clamp(1.25rem, 3vw, 1.9rem);
    display: flex;
    flex-direction: column;
  }
  /* Cancel the field’s own inline padding on the outer cells so the row spans the
     shell edge to edge; otherwise the first and last cells sit inset from
     everything else on the page. */
  .cell:first-child { padding-left: 0; }
  .cell:last-child { padding-right: 0; }
  .lb { color: var(--russet); margin-bottom: 1rem; }
  h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.5rem);
    line-height: 1.08;
    margin-bottom: 0.75rem;
  }
  .prose { font-size: 0.9375rem; max-width: none; }
  /* The value sits at the bottom of every cell regardless of how long the argument
     above it runs, so the three facts line up across the row. */
  .val {
    margin-top: auto;
    padding-top: 1.1rem;
    font-family: var(--font-display);
    font-variation-settings: var(--axis-headline);
    font-size: clamp(1.2rem, 2.2vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  /* A named gap is demoted to body type in the state colour so it can never be
     mistaken for a fact we hold. */
  .val.unknown {
    font-family: var(--font-body);
    font-variation-settings: 'wdth' 100;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--russet);
  }
  .val a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .cell { padding-left: 0; padding-right: 0; }
    .val { margin-top: 1rem; }
  }
</style>
