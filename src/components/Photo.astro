---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Pins the fallback `src`. Without it Astro uses the untouched original, so
   *  the build ships a full-resolution variant no viewport ever asks for. */
  width?: number;
  /** Describes the MATERIAL, never the premises. See the note below. */
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
}
const { src, alt, caption, width, widths = [400, 800], sizes = '(max-width: 760px) 100vw, 46rem' } = Astro.props;
---
<!--
  Material photography only.

  Agwood owns no pictures of its own mill, yard, product or crew, and may not for
  months. What this site is allowed to show is the MATERIAL — redwood itself —
  because a photograph of redwood makes no claim about whose yard it was taken in.

  The line that must hold in every future edit: nothing here may be captioned,
  placed, or implied as Agwood's premises, equipment, staff or a specific job.
  A picture of wood is a picture of wood. A picture of a mill is a claim.
-->
<figure class="photo">
  <Image src={src} alt={alt} width={width} widths={widths} sizes={sizes} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo { margin: 0; }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--size-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink-dim);
  }
  :global(.forest) figcaption { color: var(--on-deep-dim); }
</style>
