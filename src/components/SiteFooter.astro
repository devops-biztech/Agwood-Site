---
import { COMPANY, PHONE_HREF } from '../data/company.ts';
import { PAGES, navLabel } from '../data/site.ts';
import Emblem from './Emblem.astro';

const year = new Date().getFullYear();
const here = Astro.url.pathname;
---
<footer class="ftr">
  <div class="shell">
    <!-- 64px, raised from 46px on 2026-08-27. The floor is measured — the emblem was
         rendered at 44, 56, 64, 72 and 88, and below 64 the conifer branches merge
         into a blob. That is the mark's own geometry, so going vector did not lift
         it; the footer had simply been under the floor since it was built. -->
    <Emblem height={64} class="mark" />
    <div class="cols">
      <!-- Rendered from src/data/company.ts, never retyped. These bytes have to
           match the contact page, the structured data and the Google Business
           Profile exactly; a stray "Rd." reads as a different business. -->
      <div>
        <b>{COMPANY.name}</b>
        <address>
          {COMPANY.address.street}<br />
          {COMPANY.address.locality}, {COMPANY.address.region} {COMPANY.address.postalCode}
        </address>
        <!-- The number sits with the address rather than in a column of its own.
             Name, address and telephone are ONE record — it is the unit search
             engines reconcile against a Google Business Profile, and the unit a
             buyer copies down. Splitting the telephone off was what left the
             address block looking like a fragment. -->
        <a href={PHONE_HREF}>{COMPANY.phone}</a>
      </div>
      <!-- The footer menu. Same labels as the header, from one source, because two
           menus that disagree about what a page is called is the kind of drift
           nobody notices until a client does. -->
      <nav aria-label="Footer">
        <b>Menu</b>
        {PAGES.map((p) => (
          <a href={p.path} class:list={{ 'is-current': here === p.path }}
             aria-current={here === p.path ? 'page' : undefined}>{navLabel(p)}</a>
        ))}
      </nav>
      <div>
        <b>Hours</b>
        <span>{COMPANY.hours.display}</span>
      </div>
    </div>
    <p class="fine">&copy; {year} {COMPANY.name}. Built by <a href="https://trustbiztech.com" rel="noopener">Biztech</a>.</p>
  </div>
</footer>

<style>
  /* The footer ground is the logo’s own outline ink — the darker of the two
     greens measured out of the mark, not a tint invented to sit near it. */
  .ftr {
    background: var(--forest-deep);
    color: var(--paper-deep);
    padding-block: var(--section);
    margin-top: var(--section);
  }
  /* Explicit colour rather than currentColor: the footer body text is paper-deep,
     but the mark stays paper so it holds the same weight it has in the header. */
  .ftr :global(.mark) { height: 64px; width: auto; display: block; color: var(--paper); margin-bottom: 1.25rem; }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem clamp(2rem, 6vw, 3.5rem);
  }
  .cols > :is(div, nav) { display: flex; flex-direction: column; gap: 0.3rem; }
  /* The menu's rows are links stacked in a column, so they get the tap height the
     header's do. Everything else in this footer is text being read, not pressed. */
  nav a { padding-block: 0.35rem; }
  /* The state colour marks where you are and marks nothing else — the same rule the
     header nav follows, in its reversed variant so it holds up on the dark ground. */
  nav a.is-current { color: var(--on-deep-mark); }
  b { color: var(--paper); font-weight: 600; }
  address { font-style: normal; line-height: 1.6; }
  /* Paper on forest-deep is 14.30:1. Footer links are underlined rather than
     coloured: green on this ground would be unreadable, and the scarcity rule
     does not get to override legibility. */
  .ftr a { color: var(--paper); text-decoration: underline; text-underline-offset: 3px; }
  .fine { margin-top: 1.75rem; font-size: var(--size-fine); opacity: 0.85; }
</style>
