---
import { verticalGrainSvg } from '../lib/grain.ts';
import { COMPANY, PHONE_HREF } from '../data/company.ts';

/**
 * Where a homeowner should go instead of the mill.
 *
 * Agwood sells wholesale, so a homeowner searching "redwood decking Ukiah" has to
 * be routed to a retailer rather than invited to call. That list does not exist
 * yet, so this ships as declared placeholder rows.
 *
 * The rows read DEALER NAME / CITY, CA rather than plausible invented business
 * names, and that is the whole point of the component. A realistic-looking fake
 * like "Mendocino Building Supply" reads as finished in a screenshot, survives
 * into production unnoticed, and names a business that never agreed to be listed.
 * These rows cannot do any of that while still showing the owner exactly the
 * shape he needs to fill in.
 */
const rows = 4;
const svg = verticalGrainSvg({ width: 1400, height: 60, rpi: 52, seed: 61, amp: 2, stroke: 1, steps: 6 });
---
<div class="dealers">
  <div class="grain" set:html={svg} />
  <ul>
    {Array.from({ length: rows }, () => (
      <li>
        <span class="nm label">Dealer name</span>
        <span class="loc label">City, CA</span>
      </li>
    ))}
  </ul>
  <p class="note">
    Stockists have not been listed yet. Call the mill on {' '}
    <a href={PHONE_HREF}>{COMPANY.phone}</a> and we will point you at the nearest
    retailer carrying our redwood.
  </p>
</div>

<style>
  .dealers { position: relative; border: 1px solid var(--grain-edge); padding: clamp(1rem, 3vw, 1.4rem); overflow: hidden; }
  .grain { position: absolute; inset: 0; opacity: 0.5; }
  .grain :global(svg) { display: block; width: 100%; height: 100%; }
  ul { position: relative; list-style: none; margin: 0 0 1.1rem; padding: 0; display: grid; gap: 0.5rem; }
  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    background: var(--paper);
    border-left: 3px solid var(--russet);
    padding: 0.7rem 0.9rem;
    color: var(--ink-dim);
  }
  .loc { opacity: 0.75; }
  .note { position: relative; max-width: 48ch; color: var(--ink-dim); }
  @media (max-width: 460px) { li { flex-direction: column; gap: 0.2rem; } }
</style>
