---
interface Props {
  /** The position in the sequence. These are numbered because they genuinely are
   *  a sequence of narrowings — one species, one channel, one place — not because
   *  numbering makes a list look considered. */
  n: string;
  heading: string;
  /** The fact the statement resolves to, set large. */
  value?: string;
  /** True when the value is a gap being named rather than data being held. */
  unknown?: boolean;
  href?: string;
}
const { n, heading, value, unknown = false, href } = Astro.props;
---
<article class="st">
  <p class="n" aria-hidden="true">{n}</p>
  <div class="body">
    <h2>{heading}</h2>
    <p class="prose"><slot /></p>
    {value && (
      <p class:list={['val', { unknown }]}>
        {href ? <a href={href}>{value}</a> : value}
      </p>
    )}
  </div>
</article>

<style>
  .st {
    display: grid;
    grid-template-columns: 6ch 1fr;
    gap: clamp(1rem, 4vw, 2.5rem);
    align-items: start;
  }
  .st + .st { margin-top: var(--field); }
  /* The numeral is an architectural element, not a bullet: Fraunces at title
     optical size in the state colour, holding its own column. */
  .n {
    font-family: var(--font-display);
    font-variation-settings: var(--axis-title);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    color: var(--russet);
    padding-top: 0.45em;
  }
  h2 { max-width: 19ch; }
  .prose { margin-top: 0.9rem; }
  .val {
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-variation-settings: var(--axis-headline);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  /* An unknown is a state, so it takes the state colour and drops to body type —
     it must not be mistaken for a fact we hold. */
  .val.unknown {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--russet);
  }
  :global(.forest) .val { color: var(--on-deep); }
  :global(.forest) .n, :global(.forest) .val.unknown { color: var(--on-deep-mark); }
  @media (max-width: 620px) {
    .st { grid-template-columns: 1fr; gap: 0.4rem; }
    .n { padding-top: 0; }
  }
</style>
