---
import { reachMapSvg } from '../lib/map.ts';
const { svg, captionInset } = reachMapSvg({ width: 760, height: 720 });
---
<!-- Generated at build time; the browser receives static markup. -->
<figure class="map">
  <div class="art" set:html={svg} />
  <!-- Indented to the state's bottom-left corner, computed from the geometry, so
       the caption starts under the base of the state instead of under the
       westernmost point of the coastline hundreds of miles north-west of it. -->
  <figcaption style={`--inset:${captionInset}`}>
    Straight-line distances from the mill. These are reference points, not a
    delivery schedule — call to confirm what we can reach.
  </figcaption>
</figure>

<style>
  .map { margin: 0; }
  /* Colour roles for the light field. Ukiah takes the STATE colour because it is
     literally where you are, which is exactly what russet is reserved for. The
     reference towns stay neutral so the one marked place is the one that reads. */
  .art {
    --map-land: rgba(36, 26, 18, 0.055);
    --map-line: var(--ink-dim);
    --map-ref: var(--ink-dim);
    --map-home: var(--russet);
    --map-dist: var(--ink-dim);
  }
  /* The SVG viewBox is tight to the drawn artwork, so the figure's box edges are
     the artwork's edges and the caption below lines up with the coastline instead
     of floating against padding. */
  /* The map ALWAYS fits the width it is given. It carried a 450px minimum inside an
     `overflow-x: auto` box on phones, to hold the labels at a legible size; both are
     gone, because that box scrolled in BOTH axes and did not contain itself:

       - `overflow-x: auto` computes `overflow-y` from `visible` to `auto`, so the
         figure became a vertical scroll container sitting in the middle of the page
         and swallowing the phone's own scroll gesture.
       - A scroll container still reports its content's min-content width upward. The
         450px travelled through the figure into the stacked grid track, which is
         `1fr` — `minmax(auto, 1fr)` — and forced the whole page 450px wide on a
         360px phone. The page scrolled sideways.

     The legibility fix that mattered stayed where it belongs: the label sizes in
     map.ts, which are ~18% up on the pre-2026-08-27 render. A drawing a phone reader
     has to drag is worse than one set slightly small under a caption that carries
     the same fact. If the labels ever need more size than fitting allows, the answer
     is a phone-tuned render out of map.ts — a wider box on a narrower screen is not
     available. */
  .art :global(svg) { display: block; width: 100%; height: auto; }
  figcaption {
    margin-top: 1.1rem;
    margin-left: var(--inset, 0);
    font-size: var(--size-fine);
    line-height: 1.5;
    color: var(--ink-dim);
    max-width: 40ch;
  }
  /* Below the breakpoint the map is small enough that an indent reads as an
     accident rather than an alignment. */
  @media (max-width: 640px) {
    figcaption { margin-left: 0; }
  }
</style>
