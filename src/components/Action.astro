---
interface Props { href: string; }
const { href } = Astro.props;
---
<!-- The single primary action on the site. Forest green appears here, on inline
     links, and on focus rings — nowhere else. It never marks position, never
     fills a heading, and never becomes a border. -->
<a class="act" href={href}><slot /></a>

<style>
  .act {
    display: inline-block;
    background: var(--forest);
    color: var(--paper);
    font-weight: 700;
    font-size: var(--size-control);
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0.01em;
    line-height: 1;
    /* 14px block padding on a 0.9rem line takes this past 44px tall. The audience
       is on a phone, frequently outdoors and often wearing gloves. */
    padding: 1rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s var(--ease);
  }
  .act:hover { background: var(--forest-hover); }
</style>
