---
import { COMPANY, PHONE_HREF } from '../data/company.ts';

/**
 * Where a homeowner should go instead of the mill.
 *
 * Agwood sells wholesale, so a homeowner searching "redwood decking Ukiah" has to
 * be routed to a distributor rather than invited to call. That list does not exist
 * yet, so this ships as declared placeholder rows.
 *
 * "Distributor" is the site's ONE word for an outlet the public can buy from. The
 * copy used to say dealer, stockist and retailer interchangeably, sometimes twice
 * in a sentence; they are one thing to a reader and they now read as one thing.
 *
 * The rows read "Distributor name / City, CA" rather than plausible invented
 * business names, and that is the whole point of the component. A realistic-looking
 * fake reads as finished in a screenshot, survives into production unnoticed, and
 * names a business that never agreed to be listed. These rows do the same job at a
 * client meeting and cannot do any of that.
 */
const rows = 4;
---
<div class="distributors">
  <ul>
    {Array.from({ length: rows }, () => (
      <li>
        <span class="label">Distributor name</span>
        <span class="label loc">City, CA</span>
      </li>
    ))}
  </ul>
  <p class="note">
    Distributors have not been listed yet. Call the mill on{' '}
    <a href={PHONE_HREF}>{COMPANY.phone}</a> and we will point you at the nearest
    distributor carrying our redwood.
  </p>
</div>

<style>
  .distributors { max-width: var(--measure); }
  ul { list-style: none; margin: 0 0 1.3rem; padding: 0; display: grid; gap: 0.5rem; }
  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(36, 26, 18, 0.055);
    border-left: 4px solid var(--russet);
    padding: 0.85rem 1rem;
    color: var(--ink-dim);
  }
  .loc { opacity: 0.7; }
  .note { color: var(--ink-dim); max-width: 48ch; font-size: var(--size-fine); }
  :global(.forest) li { background: rgba(244, 237, 227, 0.08); border-left-color: var(--on-deep-mark); color: var(--on-deep-dim); }
  :global(.forest) .note { color: var(--on-deep-dim); }
  :global(.forest) .note a { color: var(--on-deep); }
  @media (max-width: 460px) { li { flex-direction: column; gap: 0.2rem; } }
</style>
