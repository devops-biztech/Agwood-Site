---
interface Props {
  /** The specific shot that belongs here, named so it can be sourced. */
  label: string;
  /** Width-over-height of the image that will replace this. */
  ratio?: string;
}
const { label, ratio = '16 / 9' } = Astro.props;
---
<!--
  A slot for a photograph that has been specified and is being sourced — not a
  permanent placeholder. Each one names the exact shot so it can be searched for,
  and replacing it is a two-line change: swap this component for <Photo> and pass
  the import.

  It is built from the design's own material — a bounded field in the brand's
  tones, marked in the state colour. Never a grey box and never dashed
  scaffolding. If a slot is still here in six months, delete it rather than let it
  become furniture.
-->
<div class="slot" style={`aspect-ratio:${ratio}`}>
  <p class="label mark">Image to come</p>
  <p class="what">{label}</p>
</div>

<style>
  .slot {
    background: rgba(36, 26, 18, 0.055);
    border-left: 4px solid var(--russet);
    padding: clamp(1rem, 3vw, 1.4rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.4rem;
  }
  .mark { color: var(--russet); }
  .what { color: var(--ink-dim); max-width: 40ch; font-size: 0.9375rem; }
  :global(.forest) .slot { background: rgba(244, 237, 227, 0.08); border-left-color: var(--on-deep-mark); }
  :global(.forest) .mark { color: var(--on-deep-mark); }
  :global(.forest) .what { color: var(--on-deep-dim); }
</style>
