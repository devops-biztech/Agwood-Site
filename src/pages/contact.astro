---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import PhoneDisplay from '../components/PhoneDisplay.astro';
import DistributorList from '../components/DistributorList.astro';
import Photo from '../components/Photo.astro';
import Split from '../components/Split.astro';
import SpecList from '../components/SpecList.astro';
import OpenNow from '../components/OpenNow.astro';
import pack from '../assets/redwood-pack.png';
import { COMPANY, UNKNOWNS } from '../data/company.ts';
import { PAGES } from '../data/site.ts';

const meta = PAGES[2]!;

/**
 * What we hold and what we do not, in one list.
 *
 * Rendered through SpecList rather than the hand-rolled description list that used
 * to live in this file — that duplicate had drifted into its own styling for a job
 * the component already did, including the russet treatment for an unknown.
 *
 * The three UNKNOWNS rows are the point of the whole block, not an apology at the
 * bottom of it. Grades and dimensions are the first thing a wholesale buyer asks
 * and Agwood has not published them; saying so beside the facts we do hold is worth
 * more than an empty table and infinitely more than a plausible invented spec.
 */
const specRows = [
  { term: 'Species', value: 'Redwood only' },
  { term: 'Products', value: COMPANY.products.join(' · ') },
  { term: 'Sells to', value: 'Distributors' },
  ...UNKNOWNS.map((u) => ({ term: u.field, value: u.say, unknown: true })),
];
---
<Base title={meta.title} description={meta.description}>
  <Field tone="forest" reveal={false}>
    <div class="hero">
      <h1>Contact the mill.</h1>
      <!-- The number sits larger than the h1 on purpose. Heading level is document
           structure; size is emphasis, and on a page whose entire job is one phone
           call the number is what deserves the emphasis. -->
      <PhoneDisplay />
      <div class="facts">
        <div>
          <p class="label lb">Mill and office</p>
          <address>
            {COMPANY.address.street}<br />
            {COMPANY.address.locality}, {COMPANY.address.region} {COMPANY.address.postalCode}
          </address>
        </div>
        <div>
          <p class="label lb">Hours</p>
          <p>{COMPANY.hours.display}</p>
        </div>
      </div>
      <OpenNow />
      
    </div>
  </Field>

  <Field tone="paper">
    <Split ratio="minmax(0, 0.9fr) minmax(0, 1.1fr)">
      <div>
        <h2>Sourcing redwood for resale?</h2>
        <p class="prose gap">Call with the dimensions and quantity you need.</p>
        <div class="spec"><SpecList rows={specRows} /></div>
      </div>
      <!-- A banded pack is the unit a wholesale buyer actually purchases, which
           makes it the most on-message picture on the site. Material, not
           premises: no yard, forklift, building or people in frame. -->
      <Photo
        src={pack}
        alt="A banded pack of milled redwood, seen end-on."
        caption="A banded pack"
        width={840}
        widths={[420, 840]}
        sizes="(max-width: 760px) 100vw, 30rem"
      />
    </Split>
  </Field>

  <Field tone="deep">
    <Split ratio="minmax(0, 0.9fr) minmax(0, 1.1fr)">
      <div>
        <h2>Building a deck or a fence?</h2>
        <!-- The homeowner route. Agwood is wholesale, so someone arriving from a
             search for "redwood decking Ukiah" gets sent somewhere useful rather
             than a polite non-answer. -->
        <p class="prose gap">
          We do not sell direct. Our redwood reaches homeowners through
          distributors across Northern California.
        </p>
      </div>
      <DistributorList />
    </Split>
  </Field>
</Base>

<style>
  .hero { display: flex; flex-direction: column; gap: 1.1rem; }
  .hero h1 { font-size: var(--size-headline); font-variation-settings: var(--axis-headline); color: var(--on-deep-mark); }
  .facts { display: flex; flex-wrap: wrap; gap: 1.5rem clamp(2rem, 8vw, 5rem); margin-top: 0.6rem; }
  .lb { color: var(--on-deep-mark); margin-bottom: 0.45rem; }
  address { font-style: normal; line-height: 1.6; }
  .fine { font-size: var(--size-fine); color: var(--on-deep-dim); max-width: 44ch; }
  .gap { margin-top: 0.9rem; }
  .spec { margin-top: 1.4rem; }
</style>
