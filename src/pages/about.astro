---
import Base from '../layouts/Base.astro';
import GrainBand from '../components/GrainBand.astro';
import DrawnSlot from '../components/DrawnSlot.astro';
import SpecList from '../components/SpecList.astro';
import Action from '../components/Action.astro';
import { COMPANY, ADDRESS_LINE, EMAIL_HREF, UNKNOWNS } from '../data/company.ts';
import { PAGES } from '../data/site.ts';

const meta = PAGES[1]!;
---
<Base title={meta.title} description={meta.description}>
  <section class="shell head">
    <h1>A redwood mill in Ukiah.</h1>
    <p class="lede">
      {COMPANY.name} is a family-owned sawmill in {COMPANY.address.locality},
      Mendocino County. We mill redwood and sell it wholesale.
    </p>
  </section>

  <GrainBand rpi={78} seed={31} />

  <div class="alt">
    <section class="shell sec reveal">
      <h2>One species, run properly.</h2>
      <p class="prose">
        Redwood is the only species we mill. That is a choice about attention
        rather than a limit on capacity: grading redwood consistently means
        knowing how this timber moves, splits and seasons, and a mill running four
        or five species alongside it is spreading that attention thinner.
      </p>
      <p class="prose">
        Our customers are lumber retailers and distributors across Northern
        California. They resell what we grade, which means our grading has to hold
        up in someone else's yard without them re-checking it.
      </p>
    </section>
  </div>

  <GrainBand rpi={34} seed={32} />

  <section class="shell sec reveal">
    <h2 class="ttl label">The mill</h2>
    <SpecList rows={[
      { term: 'Location', value: ADDRESS_LINE },
      { term: 'County', value: 'Mendocino County, California' },
      { term: 'Species', value: 'Redwood only' },
      { term: 'Products', value: COMPANY.products.join(' · ') },
      { term: 'Sells to', value: 'Retailers and distributors' },
      { term: UNKNOWNS[0]!.field, value: UNKNOWNS[0]!.say, unknown: true },
    ]} />
  </section>

  <GrainBand rpi={78} seed={33} />

  <section class="shell sec reveal">
    <h2 class="ttl label">Still to come</h2>
    <!--
      Two declared placeholders rather than written copy, and both are deliberate.

      The company's history is genuinely interesting and genuinely unconfirmed.
      Public records point one way and the draft marketing copy points another —
      the "Since 1954" line in the Webflow scaffold is contradicted by three
      independent sources and appears nowhere except that draft. A founding year
      is checkable by anyone, so this page prints none until the owner confirms
      one. See PRODUCT.md, "Unverified, and flagged in code."
    -->
    <div class="slots">
      <DrawnSlot
        label="The mill, the yard, and the crew — photographs to come"
        note="Agwood owns no photographs of its own operation yet. Nothing here is a stock photograph standing in for one."
        seed={41}
      />
      <DrawnSlot
        label="Company history — pending confirmation"
        note="The founding year and the family's history with this mill are being confirmed with the owner. Nothing is printed here until they are."
        seed={42}
      />
    </div>
  </section>

  <GrainBand rpi={34} seed={34} />

  <section class="shell sec reveal">
    <h2>Talk to the mill.</h2>
    <p class="prose">Email is the quickest way to reach us with an enquiry.</p>
    <p class="cta"><Action href={EMAIL_HREF}>Email the mill</Action></p>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2.25rem, 6vw, 3.5rem); }
  .head h1 { max-width: 15ch; }
  .head .lede { margin-top: 1rem; }
  .sec { padding-block: var(--section); }
  .alt { background: var(--paper-deep); }
  .ttl { color: var(--russet); margin-bottom: 1rem; font-family: var(--font-body); }
  .slots { display: grid; gap: var(--stack); margin-top: 0.5rem; }
  .cta { margin-top: 1.5rem; }
</style>
