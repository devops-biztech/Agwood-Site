---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Statement from '../components/Statement.astro';
import SpecList from '../components/SpecList.astro';
import Pending from '../components/Pending.astro';
import Action from '../components/Action.astro';
import { COMPANY, ADDRESS_LINE, EMAIL_HREF, UNKNOWNS } from '../data/company.ts';
import { PAGES } from '../data/site.ts';

const meta = PAGES[1]!;
---
<Base title={meta.title} description={meta.description}>
  <Field tone="forest" reveal={false}>
    <div class="hero">
      <h1>A redwood mill in Ukiah.</h1>
      <p class="lede">
        {COMPANY.name} is a family-owned sawmill in {COMPANY.address.locality},
        Mendocino County. We mill redwood and sell it wholesale.
      </p>
    </div>
  </Field>

  <Field tone="paper">
    <Statement n="01" heading="One species, run properly." value="Redwood only">
      Redwood is the only timber we mill. That is a choice about attention rather
      than a limit on capacity: grading redwood consistently means knowing how this
      wood moves, splits and seasons, and that knowledge does not transfer from
      one species to the next.
    </Statement>
  </Field>

  <Field tone="deep">
    <Statement n="02" heading="Our grading has to hold up in someone else's yard." value="Wholesale">
      We sell to lumber retailers and distributors across Northern California. They
      resell what we grade, under their own name, to customers we never meet. That
      only works if what is on the sticker is what is in the pack.
    </Statement>
  </Field>

  <Field tone="paper">
    <h2 class="ttl label">The mill</h2>
    <SpecList rows={[
      { term: 'Location', value: ADDRESS_LINE },
      { term: 'County', value: 'Mendocino County, California' },
      { term: 'Species', value: 'Redwood only' },
      { term: 'Products', value: COMPANY.products.join(' · ') },
      { term: 'Sells to', value: 'Retailers and distributors' },
      { term: UNKNOWNS[0]!.field, value: UNKNOWNS[0]!.say, unknown: true },
    ]} />
  </Field>

  <Field tone="deep">
    <h2 class="ttl label">Still to come</h2>
    <!--
      Two declared placeholders rather than written copy, and both are deliberate.

      The company's history is genuinely interesting and genuinely unconfirmed.
      The "Since 1954" line in the Webflow draft is contradicted by three
      independent sources and appears nowhere else. A founding year is checkable
      by anyone, so this page prints none until the owner confirms one. See
      PRODUCT.md, "Unverified, and flagged in code."
    -->
    <div class="pends">
      <Pending
        label="The mill, the yard and the crew — photographs to come"
        note="Agwood owns no photographs of its own operation yet. Nothing on this site is a stock photograph standing in for one."
      />
      <Pending
        label="Company history — pending confirmation"
        note="The founding year and the family's history with this mill are being confirmed with the owner. Nothing is printed here until they are."
      />
    </div>
  </Field>

  <Field tone="paper">
    <h2>Talk to the mill.</h2>
    <p class="prose lede-gap">Email is the quickest way to reach us with an enquiry.</p>
    <p class="cta"><Action href={EMAIL_HREF}>Email the mill</Action></p>
  </Field>
</Base>

<style>
  .hero h1 { max-width: 14ch; font-size: clamp(2.4rem, 6.4vw, 4rem); }
  .hero .lede { margin-top: 1.4rem; }
  .ttl { color: var(--russet); margin-bottom: 1.4rem; font-family: var(--font-body); }
  :global(.forest) .ttl { color: var(--on-deep-mark); }
  .pends { display: grid; gap: var(--stack); }
  .lede-gap { margin-top: 1rem; }
  .cta { margin-top: 2rem; }
</style>
