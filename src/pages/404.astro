---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import SpecList from '../components/SpecList.astro';
import Action from '../components/Action.astro';
import { COMPANY, ADDRESS_LINE, PHONE_HREF } from '../data/company.ts';
---
<!--
  noindex is forced here in EVERY environment, production included, rather than
  being left to the INDEXABLE flag. A 404 that gets indexed competes with the real
  pages for the same queries and hands a searcher a dead end.

  noCanonical is set for a different reason. This page answers at every wrong URL
  on the site, so naming /404/ as its one true address would be a claim that is
  false everywhere it is actually served.
-->
<Base
  title="Page not found"
  description="That page does not exist on the Agwood Mill & Lumber site."
  noindex={true}
  noCanonical={true}
>
  <Field tone="forest" reveal={false}>
    <div class="hero">
      <p class="label kicker">Error 404</p>
      <h1>That page isn&rsquo;t here.</h1>
      <p class="lede">
        The address you followed does not exist on this site. The mill is still in
        Ukiah and the telephone still works.
      </p>
      <p class="cta"><Action href="/" onDeep>Back to the home page</Action></p>
    </div>
  </Field>

  <Field tone="paper" reveal={false}>
    <h2>Reach the mill.</h2>
    <SpecList rows={[
      { term: COMPANY.name, value: ADDRESS_LINE },
      { term: 'Telephone', value: COMPANY.phone, href: PHONE_HREF },
      { term: 'Hours', value: COMPANY.hours.display },
    ]} />
  </Field>
</Base>

<style>
  .kicker { color: var(--on-deep-mark); margin-bottom: 1rem; }
  .hero h1 { max-width: 14ch; font-size: clamp(2.4rem, 6.4vw, 4rem); }
  .hero .lede { margin-top: 1.4rem; }
  .cta { margin-top: 2rem; }
</style>
