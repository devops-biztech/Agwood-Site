---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Statement from '../components/Statement.astro';
import Action from '../components/Action.astro';
import { COMPANY, PHONE_HREF, EMAIL_HREF } from '../data/company.ts';
import { PAGES } from '../data/site.ts';

const meta = PAGES[0]!;
---
<Base title={meta.title} description={meta.description}>
  <!-- The hero continues the header's field. One uninterrupted band of the
       logo's own green from the top of the page to the first statement. -->
  <Field tone="forest" reveal={false}>
    <div class="hero">
      <h1>Redwood is our full time job.</h1>
      <p class="lede">
        {COMPANY.products.join(', ')} from one mill in Ukiah. Sold wholesale to
        retailers and distributors across Northern California.
      </p>
      <p class="cta"><Action href={EMAIL_HREF} onDeep>Email the mill</Action></p>
    </div>
  </Field>

  <Field tone="paper">
    <Statement n="01" heading="One species, run properly." value="Redwood only">
      Redwood is the only timber we mill. Grading it consistently means knowing how
      this wood moves, splits and seasons — and a mill running four or five species
      alongside it is spreading that attention thinner.
    </Statement>
  </Field>

  <Field tone="deep">
    <Statement n="02" heading="We sell to the people who sell to everyone else." value="Wholesale">
      Our customers are lumber retailers and distributors across Northern
      California. They resell what we grade, which means our grading has to hold up
      in someone else's yard without them re-checking it.
    </Statement>
  </Field>

  <Field tone="paper">
    <Statement
      n="03"
      heading="Grades and dimensions."
      value={`Call the mill — ${COMPANY.phone}`}
      href={PHONE_HREF}
      unknown
    >
      Not published yet. Call the mill and we will tell you exactly what is running.
    </Statement>
  </Field>

  <Field tone="deep">
    <h2>Talk to the mill.</h2>
    <p class="prose gap-sm">
      Email reaches us fastest. Full address, telephone and hours are on the
      contact page and at the foot of every page.
    </p>
    <p class="cta"><Action href={EMAIL_HREF}>Email the mill</Action></p>
  </Field>

</Base>

<style>
  .hero h1 { max-width: 13ch; font-size: clamp(2.6rem, 7.4vw, 4.6rem); }
  .hero .lede { margin-top: 1.5rem; max-width: 40ch; }
  .cta { margin-top: 2rem; }
  .gap-sm { margin-top: 1rem; }
</style>
