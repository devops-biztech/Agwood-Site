---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Cells from '../components/Cells.astro';
import Cell from '../components/Cell.astro';
import Action from '../components/Action.astro';
import Photo from '../components/Photo.astro';
import Split from '../components/Split.astro';
import stack from '../assets/lumber-stack.png';
import { COMPANY, PRODUCTS_SENTENCE, PHONE_HREF } from '../data/company.ts';
import { PAGES } from '../data/site.ts';

const meta = PAGES[0]!;
/** The page every closing call to action points at. */
const contact = PAGES[2]!;
---
<Base title={meta.title} description={meta.description}>
  <!-- The hero continues the header’s field: one uninterrupted band of the logo’s
       own outline green from the top of the page to the first cell. -->
  <Field tone="forest" reveal={false}>
    <div class="hero">
      <h1>Redwood is our full time job.</h1>
      <p class="lede">
        {PRODUCTS_SENTENCE} from one mill in Ukiah. Sold wholesale to
        distributors across Northern California.
      </p>
      <p class="cta"><Action href={PHONE_HREF} onDeep>Call the mill — {COMPANY.phone}</Action></p>
    </div>
  </Field>

  <Field tone="paper">
    <Cells>
      <Cell label="Species" heading="One species, run properly." value="Redwood only">
        Redwood is the only timber we mill. Grading it consistently means knowing
        how this wood moves, splits and seasons.
      </Cell>
      <Cell label="Channel" heading="The market’s supplier." value="Wholesale">
        We sell to lumber distributors, not to the public. They resell what we
        grade, so our grading has to hold up in someone else’s yard.
      </Cell>
      <Cell
        label="Specification"
        heading="Grades and dimensions."
        value={`Call the mill — ${COMPANY.phone}`}
        href={PHONE_HREF}
        unknown
      >
        Not published yet. Call the mill and we will tell you exactly what is
        running.
      </Cell>
    </Cells>
  </Field>

  <Field tone="deep">
    <Split flip>
      <div>
        <h2>What comes off the saw.</h2>
        <p class="prose gap">
          Timbers, decking and fencing, graded to one standard because there is
          only one species to grade. One source, one grade, one consistent result — every board the same as the last.
        </p>
      </div>
      <!-- Material, not premises: board ends face-on with no yard, building,
           machinery or people in frame. It shows the wood, and claims nothing
           about whose stack it is. -->
      <Photo
        src={stack}
        alt="Courses of milled redwood stacked end-on, banded into units."
        caption="Redwood, stacked"
        width={1000}
        widths={[500, 1000]}
        sizes="(max-width: 860px) 100vw, 26rem"
      />
    </Split>
  </Field>

  <Field tone="paper" size="tight">
    <h2>Talk to the mill.</h2>
    <p class="prose gap-sm">
      The mill office answers the telephone during working hours. Full address
      and hours are on the contact page and at the foot of every page.
    </p>
    <!-- This one goes to the contact page, not to the dialler. It closes a page
         that has been making an argument, and the reader at the foot of it may be
         looking for the address, the hours or the distributor list rather than the
         telephone — the contact page holds all four, the dialler holds one. The
         hero's call to action, where the intent IS to ring, still dials. -->
    <p class="cta"><Action href={contact.path}>Contact the mill</Action></p>
  </Field>
</Base>

<style>
  /* The hero owns the first screen. It used to be a ~400px strip of green carrying a
     heading at two-thirds of the display size, which is why the site opened quietly.
     `svh` rather than `vh` so mobile browser chrome appearing and disappearing does
     not resize the first thing anyone sees. */
  .hero {
    min-height: clamp(18rem, 58svh, 30rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* No font-size override: the h1 now takes --size-display straight, which is the
     whole point of raising that step. The measure keeps it a solid block of type
     rather than one long line. */
  .hero h1 { max-width: 13ch; }
  .hero .lede { margin-top: 1.5rem; max-width: 40ch; }
  .cta { margin-top: 2rem; }
  .gap-sm { margin-top: 1rem; }
  .gap { margin-top: 0.9rem; }
</style>
